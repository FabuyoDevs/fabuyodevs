rules_version = '2';

// ============================================================================
// FABUYO — Cloud Firestore Security Rules
// ----------------------------------------------------------------------------
// projects    → world-readable (public portfolio), write = signed-in admin only
// inquiries   → anyone may CREATE a lead (contact form), everything else is
//               restricted to the signed-in admin
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase Auth is the admin boundary for this client-only portal.
    function isAdmin() {
      return request.auth != null;
    }

    // ---- Portfolio projects -------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.published == true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(
             ['title', 'category', 'description', 'liveUrl', 'imageUrl', 'published'])
        && request.resource.data.published is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 90
        && request.resource.data.category in
             ['E-commerce', 'Corporate', 'Service', 'Creative']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.imageUrl is string
        && request.resource.data.liveUrl.matches('^https://.*');

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
             .hasOnly(['title', 'category', 'description',
                       'liveUrl', 'imageUrl', 'imagePath', 'published', 'updatedAt'])
        && request.resource.data.published is bool;

      allow delete: if isAdmin();
    }

    // ---- Contact-form leads --------------------------------------------------
    match /inquiries/{inquiryId} {
      allow get, list: if isAdmin();          // only the owner reads leads
      allow update, delete: if isAdmin();

      // Public may only CREATE a well-formed lead — never read them back
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'company', 'service', 'budget',
           'message', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.matches(
             '^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && (!request.resource.data.keys().hasAny(['company'])
          || request.resource.data.company is string)
        && (!request.resource.data.keys().hasAny(['service'])
          || request.resource.data.service is string)
        && (!request.resource.data.keys().hasAny(['budget'])
          || request.resource.data.budget is string)
        && (!request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status == 'new')
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
